{
  "name": "stockroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/register.mjs --test --test-isolation=none \"tests/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import ./scripts/register.mjs scripts/migrate.ts",
    "db:seed": "node --import ./scripts/register.mjs scripts/seed.ts",
    "db:reset": "node --import ./scripts/register.mjs scripts/reset.ts",
    "db:doctor": "node --import ./scripts/register.mjs scripts/db-doctor.ts",
    "check:ledger": "node --import ./scripts/register.mjs scripts/check-ledger.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@swc/helpers": "^0.5.24",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "postgres": "^3.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.9.0"
  }
}
