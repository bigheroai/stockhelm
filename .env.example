# ── Database ────────────────────────────────────────────────────────────────
# Leave empty in development to use the embedded PGlite database in .data/pg.
# In production set a real Postgres URL.

# Supabase — the app connects through the pooler (IPv4, transaction mode):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations use the direct connection instead (port 5432). See README.
DATABASE_URL=

# Installing the Netlify ↔ Supabase integration? It injects SUPABASE_DATABASE_URL
# and the app reads it automatically when DATABASE_URL is empty.
# SUPABASE_DATABASE_URL=

# Connections per instance. Defaults to 1 on serverless hosts, 10 elsewhere.
# With Supabase's transaction pooler, keep this small.
DATABASE_POOL_MAX=

# ── Business settings ───────────────────────────────────────────────────────
# ISO-4217 currency used for prices and receipts.
CURRENCY=USD
# Sales tax in basis points (800 = 8%). Applied at the counter.
TAX_RATE_BPS=0
# Location code that counter sales are fulfilled from.
SALE_LOCATION_CODE=COUNTER
# Public name shown in the UI and on receipts.
COMPANY_NAME=Stockroom

# ── Auth ────────────────────────────────────────────────────────────────────
# Used only by `pnpm db:seed` to create the first administrator.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
# `false` seeds only staff + starter locations — no demo products or sales.
# Use this for a production project.
SEED_DEMO=true
